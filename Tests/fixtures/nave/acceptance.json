{
  "name": "nave-vertical-slice",
  "fixture": "fixture.json",
  "steps": [
    {"do": "load_disk", "file": "nave.dsk", "drive": "A"},
    {"do": "load_symbols", "file": "nave.noi"},
    {"do": "reset", "model": "6128"},
    {"do": "wait", "event": "boot_ready"},
    {"do": "type_text", "text": "run\"nave\n"},
    {"do": "wait", "until": {"peek": "game_status", "eq": "0x5A"}, "timeout_frames": 3000},
    {"do": "expect", "peek": "game_status", "eq": "0x5A"},
    {"do": "run", "frames": 25},
    {"do": "expect", "name": "drones patrol", "peek_changes": ["game_storage+37*1+4", "game_storage+37*2+4", "game_storage+37*3+4"], "over_frames": 25},
    {"do": "hold_keys", "row": 0, "mask": "0xFD", "until": {"peek": "game_storage+4", "eq": 76}, "timeout_frames": 600},
    {"do": "run", "frames": 15},
    {"do": "expect", "name": "player stops at right edge", "peek": "game_storage+4", "eq": 76},
    {"do": "release_keys"},
    {"do": "hold_keys", "row": 1, "mask": "0xFE", "until": {"peek": "game_storage+4", "eq": 0}, "timeout_frames": 900},
    {"do": "run", "frames": 15},
    {"do": "expect", "name": "player stops at left edge, no u8 wrap", "peek": "game_storage+4", "eq": 0},
    {"do": "release_keys"},
    {"do": "hold_keys", "row": 0, "mask": "0xFE", "until": {"peek": "game_storage+5", "eq": 44}, "timeout_frames": 600},
    {"do": "run", "frames": 15},
    {"do": "expect", "name": "player stops at top", "peek": "game_storage+5", "eq": 44},
    {"do": "release_keys"},
    {"do": "hold_keys", "row": 0, "mask": "0xFB", "until": {"peek": "game_storage+5", "eq": 192}, "timeout_frames": 900},
    {"do": "run", "frames": 15},
    {"do": "expect", "name": "player stops at bottom", "peek": "game_storage+5", "eq": 192},
    {"do": "release_keys"},
    {"do": "screenshot", "at": "frame_sync", "file": "final.png"},
    {"do": "record", "state_hash": "final"}
  ],
  "determinism": "Run the whole script twice from a cold start: the 'final' state_hash must be identical. Then take a snapshot at 'game_status == 0x5A', restore it, replay the key steps: same hash.",
  "timing_budget": "complete script under 3 s wall clock on the VPS (no real-time waits)"
}
